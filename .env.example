SWARM_PORT=18765
SWARM_BIND=127.0.0.1
# Phone/tablet access on the same network (trusted home network ONLY — the
# dashboard has no login, so anyone on the LAN can control the board):
# SWARM_BIND=0.0.0.0
# COMS_TRUSTED_HOSTS=192.168.1.50,my-pc.local
SWARM_WORKSPACE=./agent-workspace
SWARM_WORKSPACE_READ_ONLY=true
COMS_LLAMACPP_BASE_URL=http://host.docker.internal:11434/v1
COMS_LLAMACPP_MODEL=LFM2.5-2.6B-Q8_0.gguf
